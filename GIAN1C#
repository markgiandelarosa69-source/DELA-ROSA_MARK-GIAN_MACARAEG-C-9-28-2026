‎//grid - baase movement
‎//attach this to a character gameobject.good for roquelikes puzzle games,tactics games.
‎//the character snaps to whole tile position rathen than continiuosly.
‎
‎using unityEngine;
‎
‎public class gridMovement:MonoBehavior
‎{
‎    public float tilesSize = 1.0f; //size of one grid cell
‎    public float moveSpeed = 10f
‎
‎        private vector3 targetPosition;
‎        private bool is Moving = false;
‎
‎        void Start()
‎        {
‎            //snap starting position to the grid so everything so lines up targetposition
‎        }
‎        void update()
‎        {
‎            if (!isMoving)
‎            {
‎
‎                HandleInput();
‎            }
‎            else{
‎                 //Smothly
‎   
‎                {
‎
‎                transform.position = targetPosition;
‎                    isMoving = false;
‎
‎                }
‎
‎            }
‎
‎        }
‎
‎    void HandleInput()
‎    {
‎        Vector3 direction =Vector.zero;
‎
‎        if(Input.GetKeyDown(keyCode.W)) direction = Vector3.up;
‎        else if (Input.GetKeyDown(KeyCode. S)) direction =
‎            Vector3.down;
‎        else if (Input.GetKeydown(KeyCode. A)) direction =
‎            Vector3.left;
‎        else if (Input.GetKeyDown(KeyCode. D)) direction =
‎            Vector3.right;
‎
‎        if(direction !=Vector3.zero)
‎        {
‎            targetPosition = transform.position + direction * tileSize;
‎            isMoving = true;
‎        }
‎    }
‎    Vector3 SnapToGrid(Vector3 pos)
‎    {
‎        return new Vector3(
‎            Mathf.Round(pos.x / tileSize) * tileSize,
‎            Mathf.Round(pos.y / tileSize) * tileSize,
‎            pos.z
‎        );
‎    }
